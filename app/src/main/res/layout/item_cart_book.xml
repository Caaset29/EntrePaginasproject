<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Portada -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardImage"
            android:layout_width="80dp"
            android:layout_height="110dp"
            app:cardCornerRadius="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageView
                android:id="@+id/imgCartBook"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@android:color/darker_gray"
                android:scaleType="centerCrop"/>
        </androidx.cardview.widget.CardView>

        <!-- Título -->
        <TextView
            android:id="@+id/tvCartTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="El Jardín Secreto"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#333"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintStart_toEndOf="@id/cardImage"
            app:layout_constraintEnd_toStartOf="@id/layoutQuantity"
            app:layout_constraintTop_toTopOf="parent"/>

        <!-- Autor -->
        <TextView
            android:id="@+id/tvCartAuthor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Ana García"
            android:textSize="12sp"
            android:textColor="#757575"
            android:layout_marginStart="12dp"
            app:layout_constraintStart_toEndOf="@id/cardImage"
            app:layout_constraintEnd_toStartOf="@id/layoutQuantity"
            app:layout_constraintTop_toBottomOf="@id/tvCartTitle"/>

        <!-- Precio -->
        <TextView
            android:id="@+id/tvCartPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="S/ 59.90"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/red_primary"
            android:layout_marginTop="8dp"
            android:layout_marginStart="12dp"
            app:layout_constraintStart_toEndOf="@id/cardImage"
            app:layout_constraintTop_toBottomOf="@id/tvCartAuthor"/>

        <!-- Controles de Cantidad (+ 1 -) -->
        <LinearLayout
            android:id="@+id/layoutQuantity"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#F5F5F5"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/btnMinus"
                android:layout_width="30dp"
                android:layout_height="match_parent"
                android:src="@drawable/ic_remove"
                app:tint="@color/red_primary"
                android:padding="8dp"/>
            <!-- Si no tienes ic_remove, usa un guion simple o drawable -->

            <TextView
                android:id="@+id/tvQuantity"
                android:layout_width="30dp"
                android:layout_height="match_parent"
                android:text="1"
                android:gravity="center"
                android:textStyle="bold"
                android:textColor="#333"/>

            <ImageView
                android:id="@+id/btnPlus"
                android:layout_width="30dp"
                android:layout_height="match_parent"
                android:src="@drawable/ic_add"
                app:tint="@color/red_primary"
                android:padding="8dp"/>
            <!-- Si no tienes ic_add, usa un mas simple -->
        </LinearLayout>

        <!-- Botón Eliminar (Tachito) -->
        <ImageView
            android:id="@+id/btnDelete"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_delete_outline"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>